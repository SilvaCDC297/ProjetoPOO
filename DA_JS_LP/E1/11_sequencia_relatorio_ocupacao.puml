@startuml
title Diagrama de Sequência – UC18 Visualizar relatórios (taxa de ocupação)
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam sequence {
  ParticipantBackgroundColor #F4F8FF
  ParticipantBorderColor #2F5597
  ActorBorderColor #2F5597
  LifeLineBorderColor #7F7F7F
}
autonumber
actor Administrador
participant RelatoriosController
participant SessaoAutenticacao
participant GestorRelatorios
participant GestorEspacos
participant RepositorioReservas

Administrador -> RelatoriosController : painel(inicio, fim)
activate RelatoriosController
RelatoriosController -> SessaoAutenticacao : exigirAdministrador()
alt não é administrador
  SessaoAutenticacao --> RelatoriosController : throw PermissaoNegadaException
  RelatoriosController --> Administrador : "Acesso negado"
else é administrador
  RelatoriosController -> GestorRelatorios : taxaOcupacao(inicio, fim)
  activate GestorRelatorios
  alt período inválido (fim < início)
    GestorRelatorios --> RelatoriosController : throw DadosInvalidosException
  else período válido
    GestorRelatorios -> GestorEspacos : listar()
    GestorEspacos --> GestorRelatorios : espaços
    GestorRelatorios -> RepositorioReservas : listar()
    RepositorioReservas --> GestorRelatorios : reservas
    loop para cada espaço
      GestorRelatorios -> GestorRelatorios : horasReservadas = soma da duração das reservas\nCONFIRMADA/CONCLUIDA no período
      GestorRelatorios -> GestorRelatorios : horasDisponiveis = nº de dias x (fecho - abertura)
      GestorRelatorios -> GestorRelatorios : taxa = horasReservadas / horasDisponiveis x 100
    end
    GestorRelatorios --> RelatoriosController : List<LinhaRelatorio>
    deactivate GestorRelatorios
    RelatoriosController --> Administrador : tabela e gráfico de barras
  end
end
deactivate RelatoriosController
@enduml
