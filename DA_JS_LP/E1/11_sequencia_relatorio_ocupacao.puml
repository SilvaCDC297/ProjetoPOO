@startuml
title Diagrama de Sequência – UC12 Relatório de Taxa de Ocupação
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam sequence {
  ParticipantBackgroundColor #F4F8FF
  ParticipantBorderColor #2F5597
  ActorBorderColor #2F5597
  LifeLineBorderColor #2F5597
  LifeLineBackgroundColor #E8F0FE
  ArrowColor #2F5597
}

actor Administrador
participant RelatoriosController
participant SessaoAutenticacao
participant GestorRelatorios
participant GestorEspacos
participant RepositorioReservas

Administrador -> RelatoriosController : obterRelatorioOcupacao(inicio, fim)
activate RelatoriosController

RelatoriosController -> SessaoAutenticacao : exigirAdministrador()
activate SessaoAutenticacao
SessaoAutenticacao --> RelatoriosController : ok
deactivate SessaoAutenticacao

RelatoriosController -> GestorRelatorios : calcularTaxaOcupacao(inicio, fim)
activate GestorRelatorios

GestorRelatorios -> GestorEspacos : listar()
activate GestorEspacos
GestorEspacos --> GestorRelatorios : espacos
deactivate GestorEspacos

GestorRelatorios -> RepositorioReservas : listarPorPeriodo(inicio, fim)
activate RepositorioReservas
RepositorioReservas --> GestorRelatorios : reservas
deactivate RepositorioReservas

GestorRelatorios -> GestorRelatorios : calcularEstatisticas(espacos, reservas)

GestorRelatorios --> RelatoriosController : dadosRelatorio
deactivate GestorRelatorios

RelatoriosController --> Administrador : apresenta tabela e gráficos de ocupação
deactivate RelatoriosController

@enduml