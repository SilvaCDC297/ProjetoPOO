@startuml
title Diagrama de Classes – Arquitetura em Camadas (Apresentação, Serviços e Persistência)
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam roundcorner 8

skinparam class {
  BackgroundColor #F4F8FF
  BorderColor #2F5597
  ArrowColor #2F5597
}

skinparam package {
  BackgroundColor #FAFAFA
  BorderColor #7F7F7F
  FontStyle bold
}

hide empty members

package "Apresentação (Web)" {
  class AuthController {
    + registo(nome, email, password)
    + login(email, password)
    + logout()
  }
  class EspacosController {
    + listar() : List<EspacoDesportivo>
    + detalhe(id) : EspacoDesportivo
    + adicionar(dados)
    + alterar(id, dados)
    + remover(id)
  }
  class ReservasController {
    + criar(espacoId, data, inicio, fim)
    + consultar() : List<Reserva>
    + cancelar(id)
    + confirmar(id)
  }
  class RelatoriosController {
    + painel(inicio, fim)
  }
}

package "Serviços (Lógica de Negócio)" {
  class SessaoAutenticacao {
    - utilizadorAtual : Utilizador
    + iniciar(u : Utilizador)
    + terminar()
    + obterUtilizador() : Utilizador
    + exigirAdministrador()
  }
  class GestorUtilizadores {
    + registar(nome, email, password) : Utilizador
    + autenticar(email, password) : Utilizador
    + obterPorId(id) : Utilizador
    + listar() : List<Utilizador>
  }
  class GestorEspacos {
    + adicionar(dados) : EspacoDesportivo
    + alterar(id, dados)
    + remover(id)
    + obter(id) : EspacoDesportivo
    + listar() : List<EspacoDesportivo>
  }
  class GestorReservas {
    + criar(u, espacoId, data, inicio, fim) : Reserva
    + confirmar(id)
    + cancelar(id, u)
    + verificarConflito(espaco, data, inicio, fim)
    + expirarPendentes() : int
    + listarPorUtilizador(id) : List<Reserva>
  }
  class GestorRelatorios {
    + totalReservas() : int
    + reservasPorEspaco() : Map
    + taxaOcupacao(inicio, fim) : double
  }
}

package "Persistência (JSON)" {
  interface IRepositorio<T> {
    + listar() : List<T>
    + obterPorId(id) : T
    + adicionar(item : T)
    + atualizar(item : T)
    + remover(id)
  }
  abstract class RepositorioJson<T> {
    # caminhoFicheiro : string
    + carregar() : List<T>
    + guardar(itens)
  }
  class RepositorioUtilizadores
  class RepositorioEspacos
  class RepositorioReservas
}

package "Modelo de Domínio" {
  class Utilizador
  class EspacoDesportivo
  class Reserva
}

' Relações Apresentação -> Serviços
AuthController ..> GestorUtilizadores
AuthController ..> SessaoAutenticacao
EspacosController ..> GestorEspacos
ReservasController ..> GestorReservas
RelatoriosController ..> GestorRelatorios

' Serviços entre si
GestorReservas --> GestorEspacos
GestorRelatorios --> GestorEspacos
GestorRelatorios --> GestorReservas

' Serviços -> Persistência
GestorUtilizadores --> IRepositorio
GestorEspacos --> IRepositorio
GestorReservas --> IRepositorio

' Implementação da Persistência
IRepositorio <|.. RepositorioJson
RepositorioJson <|-- RepositorioUtilizadores
RepositorioJson <|-- RepositorioEspacos
RepositorioJson <|-- RepositorioReservas

' Persistência -> Domínio
RepositorioUtilizadores ..> Utilizador : <<usa>>
RepositorioEspacos ..> EspacoDesportivo : <<usa>>
RepositorioReservas ..> Reserva : <<usa>>

@enduml