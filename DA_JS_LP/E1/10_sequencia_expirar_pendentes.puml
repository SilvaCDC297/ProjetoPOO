@startuml
title Diagrama de Sequência – Processos Automáticos (Expirar e Concluir)
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam sequence {
  ParticipantBackgroundColor #F4F8FF
  ParticipantBorderColor #2F5597
  ActorBorderColor #2F5597
  LifeLineBorderColor #2F5597
  LifeLineBackgroundColor #E8F0FE
  ArrowColor #2F5597
}

participant AgendadorReservas
participant GestorReservas
participant RepositorioReservas
participant Reserva

AgendadorReservas -> GestorReservas : expirarPendentes()
activate GestorReservas

GestorReservas -> RepositorioReservas : listarPendentesExpiradas()
activate RepositorioReservas
RepositorioReservas --> GestorReservas : listaReservas
deactivate RepositorioReservas

GestorReservas -> Reserva : expirar()
activate Reserva
Reserva --> GestorReservas : estado = EXPIRADA
deactivate Reserva

GestorReservas -> RepositorioReservas : atualizar(reserva)
activate RepositorioReservas
RepositorioReservas -> RepositorioReservas : guardar()
RepositorioReservas --> GestorReservas : ok
deactivate RepositorioReservas

GestorReservas --> AgendadorReservas : totalExpiradas
deactivate GestorReservas

AgendadorReservas -> GestorReservas : concluirTerminadas()
activate GestorReservas

GestorReservas -> RepositorioReservas : listarConfirmadasTerminadas()
activate RepositorioReservas
RepositorioReservas --> GestorReservas : listaReservas
deactivate RepositorioReservas

GestorReservas -> Reserva : concluir()
activate Reserva
Reserva --> GestorReservas : estado = CONCLUIDA
deactivate Reserva

GestorReservas -> RepositorioReservas : atualizar(reserva)
activate RepositorioReservas
RepositorioReservas -> RepositorioReservas : guardar()
RepositorioReservas --> GestorReservas : ok
deactivate RepositorioReservas

GestorReservas --> AgendadorReservas : totalConcluidas
deactivate GestorReservas

@enduml