@startuml
title Diagrama de Casos de Uso – Gestão de Reservas de Espaços Desportivos
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultFontName DejaVu Sans
skinparam usecase {
  BackgroundColor #F4F8FF
  BorderColor #2F5597
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #2F5597
}

actor "Utilizador" as U
actor "Administrador" as A

U <|-- A

rectangle "Sistema de Gestão de Reservas de Espaços Desportivos" {
  usecase "UC01\nRegistar-se" as UC01
  usecase "UC02\nIniciar sessão" as UC02
  usecase "UC03\nTerminar sessão" as UC03
  usecase "UC04\nGerir perfil" as UC04
  usecase "UC05\nConsultar espaços" as UC05
  usecase "UC06\nCriar reserva" as UC06
  usecase "UC07\nConsultar reservas" as UC07
  usecase "UC08\nCancelar reserva" as UC08

  usecase "UC09\nGerir espaços" as UC09
  usecase "UC10\nGerir utilizadores" as UC10
  usecase "UC11\nConfirmar reserva" as UC11
  usecase "UC12\nVer relatórios" as UC12
}

U --> UC01
U --> UC02
U --> UC03
U --> UC04
U --> UC05
U --> UC06
U --> UC07
U --> UC08

A --> UC09
A --> UC10
A --> UC11
A --> UC12

note right of UC07
  Utilizador: vê as suas reservas.
  Administrador: vê todas.
end note
@enduml
