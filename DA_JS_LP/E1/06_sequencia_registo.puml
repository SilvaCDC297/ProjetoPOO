@startuml
title Diagrama de Sequência – UC01 Registar Utilizador
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam sequence {
  ParticipantBackgroundColor #F4F8FF
  ParticipantBorderColor #2F5597
  ActorBorderColor #2F5597
  LifeLineBorderColor #2F5597
  LifeLineBackgroundColor #E8F0FE
  ArrowColor #2F5597
}

actor Visitante
participant AuthController
participant GestorUtilizadores
participant RepositorioUtilizadores
participant UtilizadorNormal

Visitante -> AuthController : registo(nome, email, password)
activate AuthController

AuthController -> GestorUtilizadores : registar(nome, email, password)
activate GestorUtilizadores

GestorUtilizadores -> RepositorioUtilizadores : procurarPorEmail(email)
activate RepositorioUtilizadores
RepositorioUtilizadores --> GestorUtilizadores : emailDisponivel
deactivate RepositorioUtilizadores

GestorUtilizadores -> UtilizadorNormal ** : criar(nome, email, hash(password))

GestorUtilizadores -> RepositorioUtilizadores : adicionar(utilizador)
activate RepositorioUtilizadores
RepositorioUtilizadores -> RepositorioUtilizadores : guardar()
RepositorioUtilizadores --> GestorUtilizadores : ok
deactivate RepositorioUtilizadores

GestorUtilizadores --> AuthController : utilizador
deactivate GestorUtilizadores

AuthController --> Visitante : conta criada com sucesso
deactivate AuthController

@enduml