@startuml
title Diagrama de Sequência – UC02 Autenticação (Login)
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam sequence {
  ParticipantBackgroundColor #F4F8FF
  ParticipantBorderColor #2F5597
  ActorBorderColor #2F5597
  LifeLineBorderColor #2F5597
  LifeLineBackgroundColor #E8F0FE
  ArrowColor #2F5597
}

actor Utilizador
participant AuthController
participant GestorUtilizadores
participant RepositorioUtilizadores
participant UtilizadorEntidade as "Utilizador"
participant SessaoAutenticacao

Utilizador -> AuthController : login(email, password)
activate AuthController

AuthController -> GestorUtilizadores : autenticar(email, password)
activate GestorUtilizadores

GestorUtilizadores -> RepositorioUtilizadores : procurarPorEmail(email)
activate RepositorioUtilizadores
RepositorioUtilizadores --> GestorUtilizadores : utilizador
deactivate RepositorioUtilizadores

GestorUtilizadores -> UtilizadorEntidade : verificarPassword(password)
activate UtilizadorEntidade
UtilizadorEntidade --> GestorUtilizadores : true
deactivate UtilizadorEntidade

GestorUtilizadores -> SessaoAutenticacao : iniciar(utilizador)
activate SessaoAutenticacao
SessaoAutenticacao --> GestorUtilizadores : ok
deactivate SessaoAutenticacao

GestorUtilizadores --> AuthController : utilizador
deactivate GestorUtilizadores

AuthController --> Utilizador : login efetuado com sucesso
deactivate AuthController

@enduml