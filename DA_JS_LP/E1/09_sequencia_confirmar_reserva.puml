@startuml
title Diagrama de Sequência – UC11 Confirmar Reserva
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam sequence {
  ParticipantBackgroundColor #F4F8FF
  ParticipantBorderColor #2F5597
  ActorBorderColor #2F5597
  LifeLineBorderColor #2F5597
  LifeLineBackgroundColor #E8F0FE
  ArrowColor #2F5597
}

actor Administrador
participant ReservasController
participant SessaoAutenticacao
participant GestorReservas
participant RepositorioReservas
participant Reserva

Administrador -> ReservasController : confirmar(reservaId)
activate ReservasController

ReservasController -> SessaoAutenticacao : exigirAdministrador()
activate SessaoAutenticacao
SessaoAutenticacao --> ReservasController : ok
deactivate SessaoAutenticacao

ReservasController -> GestorReservas : confirmar(reservaId)
activate GestorReservas

GestorReservas -> RepositorioReservas : obterPorId(reservaId)
activate RepositorioReservas
RepositorioReservas --> GestorReservas : reserva
deactivate RepositorioReservas

GestorReservas -> Reserva : confirmar()
activate Reserva
Reserva --> GestorReservas : estado = CONFIRMADA
deactivate Reserva

GestorReservas -> RepositorioReservas : atualizar(reserva)
activate RepositorioReservas
RepositorioReservas -> RepositorioReservas : guardar()
RepositorioReservas --> GestorReservas : ok
deactivate RepositorioReservas

GestorReservas --> ReservasController : sucesso
deactivate GestorReservas

ReservasController --> Administrador : reserva confirmada com sucesso
deactivate ReservasController

@enduml