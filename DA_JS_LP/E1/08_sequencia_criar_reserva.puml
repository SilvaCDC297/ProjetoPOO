@startuml
title Diagrama de Sequência – UC09 Criar Reserva
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam sequence {
  ParticipantBackgroundColor #F4F8FF
  ParticipantBorderColor #2F5597
  ActorBorderColor #2F5597
  LifeLineBorderColor #2F5597
  LifeLineBackgroundColor #E8F0FE
  ArrowColor #2F5597
}

actor Utilizador
participant ReservasController
participant SessaoAutenticacao
participant GestorReservas
participant GestorEspacos
participant RepositorioReservas
participant Reserva

Utilizador -> ReservasController : criarReserva(espacoId, data, inicio, fim)
activate ReservasController

ReservasController -> SessaoAutenticacao : obterUtilizador()
activate SessaoAutenticacao
SessaoAutenticacao --> ReservasController : utilizador
deactivate SessaoAutenticacao

ReservasController -> GestorReservas : criar(utilizador, espacoId, data, inicio, fim)
activate GestorReservas

GestorReservas -> GestorEspacos : obter(espacoId)
activate GestorEspacos
GestorEspacos --> GestorReservas : espaco
deactivate GestorEspacos

GestorReservas -> GestorReservas : verificarConflito(espaco, data, inicio, fim)

GestorReservas -> Reserva ** : criar(utilizador, espaco, data, inicio, fim, PENDENTE)

GestorReservas -> RepositorioReservas : adicionar(reserva)
activate RepositorioReservas
RepositorioReservas -> RepositorioReservas : guardar()
RepositorioReservas --> GestorReservas : ok
deactivate RepositorioReservas

GestorReservas --> ReservasController : reserva
deactivate GestorReservas

ReservasController --> Utilizador : reserva criada com sucesso (Pendente)
deactivate ReservasController

@enduml